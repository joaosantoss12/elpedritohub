# Frontend (Vite) — expostas ao browser, por isso só o URL e a anon key,
# nunca chaves privadas. Vite carrega estas automaticamente por causa do
# prefixo VITE_, sem precisar de nada no vite.config.ts.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Funções serverless (pasta api/) — correm em Node no Vercel, nunca chegam
# ao browser. O mesmo projeto Supabase, mas com a service role key (acesso
# total, só server-side).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (api/stripe/*)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Gate de login com Telegram nos Planos VIP (api/telegram/*, api/subscription/*).
# Enquanto SESSION_SECRET + TELEGRAM_CLIENT_ID não estiverem definidos, o
# checkout funciona só com login de membro (o gate fica inativo).
# - SESSION_SECRET: string aleatória para assinar o cookie tg_session
# - TELEGRAM_CLIENT_ID: client_id do bot (BotFather) — server-side
# - VITE_TELEGRAM_CLIENT_ID: o mesmo valor, exposto ao browser para o widget
# - BOT_TOKEN / NEW_GROUP_ID: token do bot e id do canal VIP (createChatInviteLink)
# Reutilizar os valores do GESTAO VIP TELEGRAM BOT / FOOTMILLION LP.
SESSION_SECRET=
TELEGRAM_CLIENT_ID=
VITE_TELEGRAM_CLIENT_ID=
BOT_TOKEN=
NEW_GROUP_ID=

# Opcional: se as tabelas subscriptions / invite_links / legacy_members viverem
# NOUTRO projeto Supabase (o do bot), aponta aqui. Caso contrário usa-se
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY acima.
TG_SUPABASE_URL=
TG_SUPABASE_KEY=

# Football-data.org (api/football/*) — proxy server-side para não expor
# a chave ao cliente.
FOOTBALL_API_KEY=
