# Frontend (Vite) — expostas ao browser, por isso só o URL e a anon key,
# nunca chaves privadas. Vite carrega estas automaticamente por causa do
# prefixo VITE_, sem precisar de nada no vite.config.ts.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Funções serverless (pasta api/) — correm em Node no Vercel, nunca chegam
# ao browser. O mesmo projeto Supabase, mas com a service role key (acesso
# total, só server-side).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (api/stripe/*)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Football-data.org (api/football/*) — proxy server-side para não expor
# a chave ao cliente.
FOOTBALL_API_KEY=
